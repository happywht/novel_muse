{
  "title": "Muse-inkos 存储格式统一方案",
  "version": "1.0.0",
  "issue": "#2",
  "date": "2026-03-29",
  "author": "database-specialist",

  "problem_analysis": {
    "summary": "inkos Truth Files 使用 Markdown 格式（YAML frontmatter + Markdown body），而 Muse 使用 JSON/IndexedDB 存储，需要实现双向无损转换。",
    "challenges": [
      "格式差异：Markdown 表格 vs JSON 对象",
      "语义映射：Muse 字段与 inkos 字段不完全一一对应",
      "数据完整性：双向转换不能丢失信息",
      "版本兼容：旧数据格式需要支持迁移",
      "性能要求：大文档转换效率"
    ],
    "existing_infrastructure": {
      "converters": "services/inkos/types/converters.ts - 已有基础转换函数",
      "mapping": "services/inkos/types/mapping.ts - 已有类型映射定义",
      "storage": "services/inkos/storage/ - 已有混合存储适配器"
    }
  },

  "solution": {
    "approach": "方案 C：增强转换层",
    "rationale": "无需修改 inkos 或 Muse 核心存储，通过增强转换层实现格式统一",
    "benefits": [
      "最小侵入性：不修改现有存储层",
      "可扩展性：易于添加新的格式支持",
      "可测试性：转换逻辑独立，易于单元测试",
      "向后兼容：支持旧版本数据格式"
    ],
    "tradeoffs": [
      "转换逻辑复杂度增加",
      "需要维护双向映射表",
      "转换性能开销"
    ]
  },

  "architecture": {
    "description": "三层架构：格式层、转换层、存储层",
    "diagram": {
      "layers": [
        {
          "name": "Format Layer (格式层)",
          "components": [
            "MarkdownParser - 解析 inkos Markdown 文件",
            "MarkdownGenerator - 生成 inkos Markdown 文件",
            "JSONSerializer - Muse JSON 序列化",
            "FormatValidator - 格式验证"
          ]
        },
        {
          "name": "Conversion Layer (转换层)",
          "components": [
            "MuseToInkosConverter - Muse -> inkos 转换",
            "InkosToMuseConverter - inkos -> Muse 转换",
            "FieldMapper - 字段映射",
            "TypeTransformer - 类型转换",
            "ConflictResolver - 冲突解决"
          ]
        },
        {
          "name": "Storage Layer (存储层)",
          "components": [
            "HybridStorageAdapter - 混合存储",
            "IndexedDBAdapter - IndexedDB 存储",
            "FileStorageAdapter - 文件系统存储",
            "SyncManager - 同步管理"
          ]
        }
      ],
      "data_flow": {
        "muse_to_inkos": [
          "1. 从 IndexedDB 读取 Muse ProjectState (JSON)",
          "2. FormatValidator 验证 JSON 结构",
          "3. MuseToInkosConverter 转换数据结构",
          "4. FieldMapper 执行字段映射",
          "5. TypeTransformer 执行类型转换",
          "6. MarkdownGenerator 生成 Markdown 文件",
          "7. FormatValidator 验证 Markdown 格式",
          "8. FileStorageAdapter 写入文件系统"
        ],
        "inkos_to_muse": [
          "1. FileStorageAdapter 读取 Markdown 文件",
          "2. FormatValidator 验证 Markdown 格式",
          "3. MarkdownParser 解析为结构化数据",
          "4. InkosToMuseConverter 转换数据结构",
          "5. FieldMapper 执行字段映射",
          "6. TypeTransformer 执行类型转换",
          "7. FormatValidator 验证 JSON 结构",
          "8. IndexedDBAdapter 写入 IndexedDB"
        ]
      }
    }
  },

  "conversion_flow": {
    "muse_to_inkos": {
      "description": "Muse ProjectState -> inkos Truth Files",
      "steps": [
        {
          "step": 1,
          "name": "Extract Project Metadata",
          "source": "ProjectState",
          "target": "book.json",
          "mappings": [
            { "source": "id", "target": "id", "transform": "direct" },
            { "source": "title", "target": "title", "transform": "direct" },
            { "source": "genre", "target": "genre", "transform": "mapGenreToInkos" },
            { "source": "premise", "target": "synopsis", "transform": "direct" }
          ]
        },
        {
          "step": 2,
          "name": "Convert World Settings",
          "source": "worldSettings[]",
          "target": ["current_state.md", "story_bible.md"],
          "mappings": [
            { "source": "Geography", "target": "currentLocation", "transform": "extractLocation" },
            { "source": "History", "target": "worldBuilding", "transform": "formatMarkdown" },
            { "source": "Magic/Tech", "target": "magicSystem", "transform": "formatMarkdown" },
            { "source": "Society", "target": "socialStructure", "transform": "formatMarkdown" }
          ]
        },
        {
          "step": 3,
          "name": "Convert Characters",
          "source": "characters[]",
          "target": "character_matrix.md",
          "mappings": [
            { "source": "name", "target": "profiles[].name", "transform": "direct" },
            { "source": "archetype", "target": "profiles[].coreTags[0]", "transform": "direct" },
            { "source": "desire", "target": "profiles[].coreMotivation", "transform": "direct" },
            { "source": "structuredRelations", "target": "encounters[]", "transform": "convertRelations" }
          ]
        },
        {
          "step": 4,
          "name": "Convert Plot Nodes",
          "source": "plotNodes[]",
          "target": ["pending_hooks.md", "subplot_board.md"],
          "mappings": [
            { "source": "id", "target": "hookId", "transform": "generateHookId" },
            { "source": "order", "target": "startChapter", "transform": "direct" },
            { "source": "beatTag", "target": "type", "transform": "mapBeatTagToHookType" },
            { "source": "content", "target": "notes", "transform": "direct" }
          ]
        },
        {
          "step": 5,
          "name": "Convert Chapters",
          "source": "chapters[]",
          "target": "chapter_summaries.md",
          "mappings": [
            { "source": "order", "target": "chapter", "transform": "direct" },
            { "source": "title", "target": "title", "transform": "direct" },
            { "source": "summary", "target": "events", "transform": "direct" },
            { "source": "content", "target": "chapterFiles[]", "transform": "createChapterFile" }
          ]
        },
        {
          "step": 6,
          "name": "Convert Echoes",
          "source": "echoes[]",
          "target": "pending_hooks.md",
          "mappings": [
            { "source": "id", "target": "hookId", "transform": "prefixEcho" },
            { "source": "type", "target": "type", "transform": "mapEchoTypeToHookType" },
            { "source": "description", "target": "notes", "transform": "appendReason" }
          ]
        },
        {
          "step": 7,
          "name": "Convert Character Arcs",
          "source": "characters[].arc",
          "target": "emotional_arcs.md",
          "mappings": [
            { "source": "arcType", "target": "trajectory", "transform": "mapArcTypeToTrajectory" },
            { "source": "currentPhase", "target": "emotionalState", "transform": "mapPhaseToEmotion" },
            { "source": "phaseProgress", "target": "intensity", "transform": "normalizeToIntensity" }
          ]
        }
      ]
    },
    "inkos_to_muse": {
      "description": "inkos Truth Files -> Muse ProjectState",
      "steps": [
        {
          "step": 1,
          "name": "Parse Book Config",
          "source": "book.json",
          "target": "ProjectState",
          "mappings": [
            { "source": "id", "target": "id", "transform": "direct" },
            { "source": "title", "target": "title", "transform": "direct" },
            { "source": "genre", "target": "genre", "transform": "mapGenreToMuse" },
            { "source": "synopsis", "target": "premise", "transform": "direct" }
          ]
        },
        {
          "step": 2,
          "name": "Parse World State",
          "source": ["current_state.md", "story_bible.md"],
          "target": "worldSettings[]",
          "mappings": [
            { "source": "currentLocation", "target": "Geography", "transform": "createWorldSetting" },
            { "source": "worldBuilding", "target": "History", "transform": "parseMarkdownToSetting" },
            { "source": "magicSystem", "target": "Magic/Tech", "transform": "parseMarkdownToSetting" }
          ]
        },
        {
          "step": 3,
          "name": "Parse Character Matrix",
          "source": "character_matrix.md",
          "target": "characters[]",
          "mappings": [
            { "source": "profiles[].name", "target": "name", "transform": "direct" },
            { "source": "profiles[].coreTags", "target": "tags", "transform": "direct" },
            { "source": "encounters[]", "target": "structuredRelations", "transform": "convertEncounters" }
          ]
        },
        {
          "step": 4,
          "name": "Parse Pending Hooks",
          "source": "pending_hooks.md",
          "target": ["plotNodes[]", "echoes[]"],
          "mappings": [
            { "source": "hookId", "target": "id", "transform": "direct" },
            { "source": "type", "target": "beatTag", "transform": "mapHookTypeToBeatTag" },
            { "source": "status", "target": "status", "transform": "mapHookStatusToEcho" }
          ]
        },
        {
          "step": 5,
          "name": "Parse Chapter Summaries",
          "source": "chapter_summaries.md",
          "target": "chapters[]",
          "mappings": [
            { "source": "chapter", "target": "order", "transform": "direct" },
            { "source": "title", "target": "title", "transform": "direct" },
            { "source": "events", "target": "summary", "transform": "direct" }
          ]
        },
        {
          "step": 6,
          "name": "Parse Emotional Arcs",
          "source": "emotional_arcs.md",
          "target": "characters[].arc",
          "mappings": [
            { "source": "trajectory", "target": "arcType", "transform": "mapTrajectoryToArcType" },
            { "source": "emotionalState", "target": "currentPhase", "transform": "mapEmotionToPhase" },
            { "source": "intensity", "target": "phaseProgress", "transform": "denormalizeFromIntensity" }
          ]
        }
      ]
    }
  },

