  "validation_rules": {
    "muse_project_state": {
      "required_fields": ["id", "title", "characters", "worldSettings", "chapters"],
      "field_types": {
        "id": "string",
        "title": "string",
        "characters": "array",
        "worldSettings": "array",
        "chapters": "array"
      },
      "constraints": {
        "characters[].id": "unique",
        "chapters[].order": "unique",
        "worldSettings[].id": "unique"
      }
    },
    "inkos_truth_files": {
      "required_files": [
        "current_state.md",
        "pending_hooks.md",
        "chapter_summaries.md",
        "subplot_board.md",
        "emotional_arcs.md",
        "character_matrix.md"
      ],
      "optional_files": [
        "particle_ledger.md",
        "story_bible.md",
        "volume_outline.md",
        "book_rules.md"
      ],
      "format_rules": {
        "markdown_tables": "Must have header row and separator",
        "yaml_frontmatter": "Optional but must be valid YAML if present",
        "encoding": "UTF-8"
      }
    },
    "conversion_integrity": {
      "roundtrip_test": "Muse -> inkos -> Muse should preserve all data",
      "checksum_validation": "Calculate checksums for critical fields",
      "field_coverage": "All required fields must be mapped"
    }
  },

  "error_handling": {
    "missing_fields": {
      "strategy": "use_default",
      "defaults": {
        "genre": "玄幻",
        "currentLocation": "未设定",
        "protagonistStatus": "正常",
        "currentGoal": "未设定",
        "status": "OPEN"
      }
    },
    "invalid_format": {
      "strategy": "throw_with_context",
      "context_fields": ["fileName", "lineNumber", "fieldPath"]
    },
    "conversion_failure": {
      "strategy": "partial_conversion",
      "behavior": "Continue with valid data, collect errors, report at end"
    }
  },

  "performance_optimization": {
    "large_projects": {
      "chapter_threshold": 100,
      "strategies": [
        "streaming_conversion",
        "batch_processing",
        "lazy_loading"
      ]
    },
    "caching": {
      "mapping_tables": "Cache in memory",
      "parsed_markdown": "Cache with LRU eviction"
    }
  },

  "testing_strategy": {
    "unit_tests": [
      "Field mapping functions",
      "Type transformation functions",
      "Markdown parser/generator",
      "Format validators"
    ],
    "integration_tests": [
      "Full Muse -> inkos conversion",
      "Full inkos -> Muse conversion",
      "Roundtrip conversion",
      "Sync operations"
    ],
    "edge_cases": [
      "Empty fields",
      "Special characters in Markdown",
      "Circular references",
      "Missing optional fields"
    ]
  },

