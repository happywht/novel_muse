              "Same timeout logic",
              "Add stream cleanup on timeout",
              "Notify SSE clients of timeout"
            ]
          },
          "exampleCode": {
            "timeoutHandler": "const timeoutId = setTimeout(() => { proc.kill('SIGTERM'); }, timeout);"
          }
