# Database Configuration
DATABASE_URL="mysql://user:password@localhost:3306/muse_novel"

# Neo4j Configuration
NEO4J_URI="neo4j://127.0.0.1:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# External API Keys
GEMINI_API_KEY="your-gemini-api-key"

# ============================================
# Authentication Configuration
# ============================================

# Node Environment
NODE_ENV=development

# Enable/Disable Authentication (default: true)
AUTH_ENABLED=true

# Authentication Mode: 'jwt' | 'api-key' | 'both' (default: api-key)
AUTH_MODE=api-key

# Skip authentication in development (use with caution!)
SKIP_AUTH=false

# ============================================
# API Key Authentication
# ============================================

# Comma-separated list of valid API keys
# Generate secure keys using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=your-secure-api-key-1,your-secure-api-key-2

# Custom API key header name (default: x-api-key)
# API_KEY_HEADER=x-api-key

# ============================================
# JWT Authentication
# ============================================

# JWT secret key (required for JWT mode)
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secure-jwt-secret-key

# JWT token expiration time (default: 24h)
# Examples: 60s, 1h, 24h, 7d
JWT_EXPIRES_IN=24h

# JWT issuer validation (optional)
# JWT_ISSUER=muse-novel-architect

# JWT audience validation (optional)
# JWT_AUDIENCE=muse-api-users

# ============================================
# Server Configuration
# ============================================

# Server port (default: 3001)
PORT=3001
