# 性能监控系统配置示例
# 将此文件复制为 .env.performance 并根据需要调整

# ============================================================
# 性能监控器配置
# ============================================================

# 最大指标历史记录数（默认：10000）
PERFORMANCE_MAX_METRICS=10000

# 性能告警配置
PERFORMANCE_ALERT_ENABLED=true
PERFORMANCE_RESPONSE_TIME_THRESHOLD=3000
PERFORMANCE_ERROR_RATE_THRESHOLD=0.05
PERFORMANCE_MEMORY_USAGE_THRESHOLD=1024
PERFORMANCE_CPU_USAGE_THRESHOLD=0.8
PERFORMANCE_CONCURRENT_REQUESTS_THRESHOLD=100

# 采样率（0-1，1 = 100% 采样）
PERFORMANCE_SAMPLING_RATE=1

# 是否启用性能分析（开发环境）
PERFORMANCE_ENABLE_PROFILING=false

# ============================================================
# 数据库监控配置
# ============================================================

# 慢查询阈值（毫秒）
DB_SLOW_QUERY_THRESHOLD=1000

# 是否启用查询日志
DB_QUERY_LOGGING_ENABLED=true

# 是否启用自动索引建议
DB_AUTO_INDEX_ENABLED=true

# 最大慢查询历史记录数
DB_MAX_SLOW_QUERY_HISTORY=1000

# ============================================================
# 系统监控配置
# ============================================================

# 系统指标采样间隔（毫秒）
SYSTEM_SAMPLING_INTERVAL=5000

# 是否启用 CPU 监控
SYSTEM_CPU_MONITORING_ENABLED=true

# 是否启用内存监控
SYSTEM_MEMORY_MONITORING_ENABLED=true

# 是否启用负载平均值监控（仅 Unix）
SYSTEM_LOAD_AVG_MONITORING_ENABLED=true

# 数据保留时间（毫秒）
SYSTEM_RETENTION_PERIOD=86400000

# ============================================================
# 性能优化配置
# ============================================================

# 是否自动应用优化建议
OPTIMIZATION_AUTO_APPLY=false

# 缓存策略配置
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300000
CACHE_MAX_SIZE=52428800
CACHE_MAX_ENTRIES=1000

# ============================================================
# 告警通知配置
# ============================================================

# 是否启用邮件告警
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_FROM=performance@example.com
ALERT_EMAIL_SMTP_HOST=smtp.example.com
ALERT_EMAIL_SMTP_PORT=587

# 是否启用 Webhook 告警
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://hooks.example.com/performance
ALERT_WEBHOOK_METHOD=POST

# 告警严重级别过滤
ALERT_MIN_SEVERITY=warning

# ============================================================
# 性能报告配置
# ============================================================

# 自动报告生成间隔（毫秒）
REPORT_AUTO_GENERATE_INTERVAL=3600000

# 报告保留时间（毫秒）
REPORT_RETENTION_PERIOD=604800000

# 是否包含详细指标
REPORT_INCLUDE_DETAILED_METRICS=true

# ============================================================
# 开发环境特定配置
# ============================================================

# 开发环境可以降低采样率以减少性能影响
if [ "$NODE_ENV" = "development" ]; then
  PERFORMANCE_SAMPLING_RATE=0.1
  SYSTEM_SAMPLING_INTERVAL=10000
  PERFORMANCE_ALERT_ENABLED=false
fi

# ============================================================
# 生产环境特定配置
# ============================================================

# 生产环境应该启用完整监控
if [ "$NODE_ENV" = "production" ]; then
  PERFORMANCE_SAMPLING_RATE=1
  SYSTEM_SAMPLING_INTERVAL=5000
  PERFORMANCE_ALERT_ENABLED=true
  PERFORMANCE_ENABLE_PROFILING=false
fi

# ============================================================
# 测试环境特定配置
# ============================================================

# 测试环境可以禁用大部分监控
if [ "$NODE_ENV" = "test" ]; then
  PERFORMANCE_SAMPLING_RATE=0
  PERFORMANCE_ALERT_ENABLED=false
  SYSTEM_SAMPLING_INTERVAL=60000
  DB_QUERY_LOGGING_ENABLED=false
fi
